# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Documentation for what each of these is used for lives in tools/TOOLSAPIKEYS.md.
# That file names these variables but never contains their values.

# AgentMail — the inbox the digest reads from and sends to.
# Inbox: jordainshryock@agentmail.to
AGENTMAIL_API_KEY=

# Apollo — contact recon. Browser login only, never the API.
# Username is documented in tools/TOOLSAPIKEYS.md (not secret); only the password lives here.
APOLLO_PASSWORD=

# Exa — primary contact search in Part 2. Optional until that step is built.
EXA_API_KEY=
